[user]
  email = bjaskulski@protonmail.com
  name = Bart Jaskulski
	signingkey = ~/.ssh/id_rsa.pub
[core]
  excludesFile = ~/.gitignore
  autocrlf = input
  pager = ~/Scripts/delta-pager
  untrackedCache = true
  fsmonitor = true
[interactive]
  diffFilter = delta --color-only --features=interactive
[commit]
	gpgsign = true
  # template = ~/.gitmessage
  verbose = true
[diff]
  tool = vimdiff
  algorithm = histogram
  colorMoved = false
[difftool "vimdiff"]
  cmd = vim -d -o \"$LOCAL\" \"$REMOTE\"
[difftool]
  prompt = false
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold # line info
  old = "#70685F" # deletions
  new = "#005A9C" # additions
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[merge]
  ff = false
  conflictstyle = zdiff3
[help]
  autocorrect = 1
[init]
  defaultBranch = main
  # templatedir = ~/.git_template
[includeIf "gitdir:~/Repos/WPDesk/"]
  path = ~/Repos/WPDesk/.gitconfig
[push]
  autoSetupRemote = true
[pull]
  rebase = true
[tag]
  sort = version:refname
[alias]
  a = add
  ap = add --patch
  all = add --all
  df = diff
  dfc = diff --cached
  c = commit
  cn = commit --no-verify
  l = log --oneline
  l1 = log -1 --oneline
  ll = log --oneline --all
  s = status
  ss = status --short --branch
  p = push
  pl = pull
  st = stash push
  sw = switch
  b = branch -v

  lasttag = describe --abbrev=0 --tags
  # Output all the changes since the most recent tag as a Markdown list:
  # git changelog
  # git changelog HEAD~5...
  changelog = "!_() { \
    range=${1:-$(git lasttag)...HEAD}; \
    printf '\nChanges since %s\n\n' $range; \
    git --no-pager log --reverse --no-merges --oneline \
    --pretty=format:'- %s' \
    $range; \
    printf '\n'; \
    };_"
# [blame]
# 	ignoreRevsFile = .git-blame-ignore-revs
[delta]
  navigate = true
  light = true
  line-numbers = true
  syntax-theme = Alabaster
  minus-style = syntax "#F0EDE8"
  minus-emph-style = syntax "#DDD6CC"
  plus-style = syntax "#DBF1FF"
  plus-emph-style = syntax "#B4D8FD"
  line-numbers-minus-style = "#70685F"
  line-numbers-plus-style = "#005A9C"
  keep-plus-minus-markers = true
[branch]
	sort = -committerdate
[gpg]
	format = ssh
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
